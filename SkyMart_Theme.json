{
  "name": "SkyMart Corporate",
  "dataColors": [
    "#2E5EAA",
    "#4C9F70",
    "#F2B134",
    "#E6533C",
    "#7C6BAF",
    "#3FA7D6",
    "#B0A08C",
    "#8B8B8B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2E5EAA",
  "good": "#4C9F70",
  "bad": "#E6533C",
  "neutral": "#F2B134",
  "maximum": "#2E5EAA",
  "center": "#F2B134",
  "minimum": "#E6533C",
  "null": "#B0A08C",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 36,
      "color": "#1F2937"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#1F2937"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#2E5EAA"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#4B5563"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 8 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#000000" } }, "transparency": 92, "position": "Bottom", "shadowSpread": 2, "shadowBlur": 8 }],
        "visualHeader": [{ "show": true, "background": { "solid": { "color": "#FFFFFF" } }, "foreground": { "solid": { "color": "#1F2937" } }, "transparency": 0 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2937" } }, "fontSize": 13, "bold": true, "alignment": "left" }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#2E5EAA" } }, "fontSize": 32, "bold": true }],
        "categoryLabels": [{ "color": { "solid": { "color": "#4B5563" } }, "fontSize": 11 }]
      }
    },
    "multiRowCard": {
      "*": {
        "card": [{ "outline": "None" }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#2E5EAA" } }, "bold": true, "fontSize": 11 }],
        "values": [{ "fontSize": 10, "backColor": { "solid": { "color": "#FFFFFF" } }, "backColorPrimary": { "solid": { "color": "#F3F4F6" } } }],
        "total": [{ "backColor": { "solid": { "color": "#E5E7EB" } }, "bold": true }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#2E5EAA" } }, "bold": true }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F9FAFB" } } }],
        "items": [{ "fontColor": { "solid": { "color": "#1F2937" } } }]
      }
    }
  }
}
